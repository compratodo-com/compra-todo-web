{
  "name": "compra-todo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "agents:run": "tsx scripts/run-agents.ts --all",
    "agents:curator": "tsx scripts/run-agents.ts --agent curator",
    "agents:importer": "tsx scripts/run-agents.ts --agent product_importer",
    "agents:all": "tsx scripts/run-agents.ts --all",
    "setup:cron": "tsx scripts/setup-cron.ts",
    "workers": "tsx src/workers/index.ts",
    "scan:trends": "tsx -e \"import { searchAllTrendingCategories } from './src/lib/ml/trends'; searchAllTrendingCategories(5, 10).then(r => console.log(JSON.stringify(r.map(p => ({id: p.id, title: p.title, price: p.price, sold: p.sold_quantity})), null, 2))).catch(console.error)\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "openai": "^4.104.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.5",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma-dbml-generator": "^0.12.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "msgpackr-extract"
    ]
  }
}
