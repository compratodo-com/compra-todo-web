{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/agents?key=@CRON_SECRET&agent=curator",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/agents?key=@CRON_SECRET&agent=economist",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/tracking?key=@CRON_SECRET",
      "schedule": "*/5 * * * *"
    }
  ]
}
